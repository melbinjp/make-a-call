{
    "rules": {
        "channels": {
            "$channelId": {
                ".read": "auth != null && data.child('members').child(auth.uid).exists()",
                ".write": "auth != null && data.child('members').child(auth.uid).exists()",

                "members": {
                    "$uid": {
                        ".write": "auth != null && auth.uid === $uid"
                    }
                },

                "signals": {
                    ".indexOn": ["timestamp"],
                    "$signalId": {
                        ".validate": "newData.hasChildren(['sender', 'timestamp'])"
                    }
                },
                "introductions": {
                    ".indexOn": ["timestamp"]
                },
                "joinRequests": {
                    ".indexOn": ["timestamp"]
                }
            }
        }
    }
}
